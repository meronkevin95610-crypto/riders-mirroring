<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet wants a console-friendly output; the default
         Microsoft.NET.Sdk config is fine but we want diagnostics output
         so the BenchmarkRunner can capture per-stage timings. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RidersMirroring.Core\RidersMirroring.Core.csproj" />
  </ItemGroup>

</Project>