<Project>

  <!--
    Directory.Build.props is automatically imported by every .csproj below this
    folder. Centralises product metadata, language version, and code style
    switches so each project file stays minimal.
  -->

  <PropertyGroup>
    <!-- Product metadata -->
    <Product>Riders Mirroring</Product>
    <Company>Riders Corp</Company>
    <Authors>Riders Corp</Authors>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) Riders Corp</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Versioning (bumped by release pipeline) -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>

    <!-- Language / nullable -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Determinism / cleanliness -->
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>