<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Dark colour palette. All brushes here are referenced via
      {DynamicResource ...} from the views, so swapping this dictionary at
      runtime re-themes the entire UI in one shot. Accent brushes are
      written into Application.Resources by ThemeService so the preset
      takes effect without editing this file.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush"        Color="#141118" />
    <SolidColorBrush x:Key="SurfaceBrush"           Color="#1A1620" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush"   Color="#221B2A" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"      Color="#2A2236" />
    <SolidColorBrush x:Key="SidebarBrush"           Color="#16101B" />

    <!-- Borders / dividers -->
    <SolidColorBrush x:Key="BorderBrush"            Color="#322640" />
    <SolidColorBrush x:Key="DividerBrush"           Color="#251D33" />

    <!-- Foreground / text -->
    <SolidColorBrush x:Key="ForegroundBrush"        Color="#F2EEF7" />
    <SolidColorBrush x:Key="ForegroundMutedBrush"   Color="#A499B5" />
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#6B5F80" />

    <!-- Accent defaults — ThemeService overrides these at runtime. -->
    <SolidColorBrush x:Key="AccentPrimaryBrush"     Color="#7F77DD" />
    <SolidColorBrush x:Key="AccentSecondaryBrush"   Color="#A87FE0" />
    <SolidColorBrush x:Key="AccentTertiaryBrush"    Color="#D4537E" />

    <!-- Log strip -->
    <SolidColorBrush x:Key="LogBackgroundBrush"     Color="#0E0B11" />
    <SolidColorBrush x:Key="LogForegroundBrush"     Color="#C8BFD8" />
    <SolidColorBrush x:Key="LogAccentBrush"         Color="#7F77DD" />

    <!-- Status / semantic -->
    <SolidColorBrush x:Key="SuccessBrush"           Color="#5DAE5D" />
    <SolidColorBrush x:Key="WarningBrush"           Color="#E0B040" />
    <SolidColorBrush x:Key="ErrorBrush"             Color="#E0526B" />

    <!-- Typography defaults -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable</FontFamily>
    <sys:Double x:Key="UiFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="UiFontSizeSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>

    <!-- A subtle 12 px corner radius used by SurfaceCard -->
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

</ResourceDictionary>