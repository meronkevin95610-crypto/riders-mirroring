<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      Light colour palette. Mirrors Dark.xaml so the rest of the app
      doesn't have to know which one is active.
    -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundBrush"        Color="#FAF7FC" />
    <SolidColorBrush x:Key="SurfaceBrush"           Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush"   Color="#F4EFFA" />
    <SolidColorBrush x:Key="SurfaceHoverBrush"      Color="#ECE3F4" />
    <SolidColorBrush x:Key="SidebarBrush"           Color="#F4EFFA" />

    <!-- Borders / dividers -->
    <SolidColorBrush x:Key="BorderBrush"            Color="#D8CFE5" />
    <SolidColorBrush x:Key="DividerBrush"           Color="#E6DEEF" />

    <!-- Foreground / text -->
    <SolidColorBrush x:Key="ForegroundBrush"        Color="#1F1A28" />
    <SolidColorBrush x:Key="ForegroundMutedBrush"   Color="#6B5F80" />
    <SolidColorBrush x:Key="ForegroundDisabledBrush" Color="#A499B5" />

    <!-- Accent defaults -->
    <SolidColorBrush x:Key="AccentPrimaryBrush"     Color="#5E54B0" />
    <SolidColorBrush x:Key="AccentSecondaryBrush"   Color="#8E68C4" />
    <SolidColorBrush x:Key="AccentTertiaryBrush"    Color="#A93B66" />

    <!-- Log strip -->
    <SolidColorBrush x:Key="LogBackgroundBrush"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="LogForegroundBrush"     Color="#3A3148" />
    <SolidColorBrush x:Key="LogAccentBrush"         Color="#5E54B0" />

    <!-- Status / semantic -->
    <SolidColorBrush x:Key="SuccessBrush"           Color="#3F8A3F" />
    <SolidColorBrush x:Key="WarningBrush"           Color="#A07207" />
    <SolidColorBrush x:Key="ErrorBrush"             Color="#A8324A" />

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

    <!-- Typography (must mirror Dark.xaml so MainWindow doesn't fall back to WPF defaults on theme switch) -->
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="UiFontSize">13</sys:Double>
    <sys:Double x:Key="UiFontSizeSmall">11</sys:Double>

</ResourceDictionary>