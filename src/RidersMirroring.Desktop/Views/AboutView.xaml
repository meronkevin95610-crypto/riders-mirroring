<UserControl x:Class="Riders.Mirroring.Desktop.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Riders.Mirroring.Desktop.ViewModels"
             xmlns:res="clr-namespace:Riders.Mirroring.Desktop.Resources"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
             mc:Ignorable="d"
             Foreground="{DynamicResource ForegroundBrush}"
             FontFamily="{DynamicResource FontFantasy}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="0,40,0,40">

            <!-- ===== Hero block : giant shield + product name + tagline ===== -->
            <StackPanel HorizontalAlignment="Center">
                <!-- Big shield logo (144x144) -->
                <Grid Width="144" Height="144" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border BorderThickness="3"
                            BorderBrush="{DynamicResource Gold1Brush}">
                        <Border.Clip>
                            <PathGeometry Figures="M 72,0 L 144,27 L 144,94 L 72,144 L 0,94 L 0,27 Z" />
                        </Border.Clip>
                        <Grid>
                            <Grid.Background>
                                <RadialGradientBrush Center="0.35,0.25" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0"   Color="#FFF4C1" />
                                    <GradientStop Offset="0.5" Color="#D4AF37" />
                                    <GradientStop Offset="1"   Color="#8B6F1A" />
                                </RadialGradientBrush>
                            </Grid.Background>
                            <Path Data="M 72,16 L 120,32 L 120,86 L 72,128 L 24,86 L 24,32 Z"
                                  Stroke="#5C4A2A" StrokeThickness="2" Fill="Transparent" />
                            <TextBlock Text="R"
                                       FontFamily="{DynamicResource FontDecorative}"
                                       FontWeight="Black" FontSize="64"
                                       Foreground="#3D2817"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Text="{Binding ProductName}"
                           FontFamily="{DynamicResource FontDecorative}"
                           FontWeight="Black" FontSize="36"
                           Foreground="{DynamicResource Gold1Brush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ProductTagline}"
                           FontFamily="{DynamicResource FontFantasy}"
                           FontStyle="Italic" FontSize="14"
                           Foreground="{DynamicResource ForegroundMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
                <TextBlock Text="{Binding VersionLine}"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontSize="12"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>

            <!-- Ornate divider -->
            <Grid Margin="40,32,40,24">
                <Line X1="0" X2="1" Stretch="Fill"
                      Stroke="{DynamicResource Gold5Brush}" StrokeThickness="1" />
                <Border Background="{DynamicResource BackgroundCanvasBrush}"
                        HorizontalAlignment="Center" Padding="12,0">
                    <TextBlock Text="&#x2756;"
                               FontSize="14"
                               Foreground="{DynamicResource Gold4Brush}" />
                </Border>
            </Grid>

            <!-- ===== Action buttons ===== -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,32">
                <Button Content="GitHub Portal"
                        Style="{DynamicResource PrimaryButton}"
                        Margin="0,0,10,0"
                        Padding="20,10"
                        FontSize="12" />
                <Button Content="Seek Updates"
                        Style="{DynamicResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Padding="20,10"
                        FontSize="12" />
            </StackPanel>

            <!-- ===== Dependencies stats row ===== -->
            <Grid Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource QcCardBorder}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="scrcpy" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource Gold3Brush}" />
                        <TextBlock Text="v2.4" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="22"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="screen mirror backend" FontFamily="{DynamicResource FontFantasy}" FontStyle="Italic" FontSize="11"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{DynamicResource QcCardBorder}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="UxPlay" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource Gold3Brush}" />
                        <TextBlock Text="v1.71" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="22"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="AirPlay receiver backend" FontFamily="{DynamicResource FontFantasy}" FontStyle="Italic" FontSize="11"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource QcCardBorder}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="License" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource Gold3Brush}" />
                        <TextBlock Text="MIT" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="22"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="0,6,0,0" />
                        <TextBlock Text="free &amp; open source" FontFamily="{DynamicResource FontFantasy}" FontStyle="Italic" FontSize="11"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Footer ===== -->
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Forged with care by Riders Software"
                           FontFamily="{DynamicResource FontFantasy}"
                           FontStyle="Italic"
                           FontSize="12"
                           Foreground="{DynamicResource ForegroundDisabledBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>