<UserControl x:Class="Riders.Mirroring.Desktop.Views.AirPlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Riders.Mirroring.Desktop.ViewModels"
             xmlns:air="clr-namespace:Riders.Mirroring.Core.AirPlay;assembly=RidersMirroring.Core"
             xmlns:res="clr-namespace:Riders.Mirroring.Desktop.Resources"
             d:DataContext="{d:DesignInstance Type=vm:AirPlayViewModel}"
             mc:Ignorable="d" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource FontFantasy}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{x:Static res:Strings.AirPlayTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{x:Static res:Strings.AirPlayDescription}"
                       Margin="0,4,0,20"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundMutedBrush}" />

            <!-- ===== Exit banner (visible only when the receiver dies) ===== -->
            <Border Background="{DynamicResource ErrorBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="14"
                    Margin="0,0,0,16"
                    Visibility="{Binding ExitBanner, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ExitBanner}"
                               Foreground="White"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12" />
                    <Button Grid.Column="1"
                            Content="âœ•"
                            Margin="8,0,0,0"
                            Padding="8,2"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding DismissExitBannerCommand}" />
                </Grid>
            </Border>

            <!-- ===== Controls ===== -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="{x:Static res:Strings.AirPlayReceiverStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ForegroundDisabledBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="14"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{x:Static res:Strings.AirPlayStartButton}"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"
                                Background="{DynamicResource AccentPrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                        <Button Content="{x:Static res:Strings.AirPlayStopButton}"
                                Padding="16,8"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsRunning}" />
                    </StackPanel>

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                               Text="{Binding BinaryHint}"
                               Margin="0,16,0,0"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource ForegroundDisabledBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- ===== Connected sessions ===== -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.AirPlayConnectedDevices}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="{Binding Sessions.Count, StringFormat='{}{0} active'}"
                               Margin="0,2,0,12"
                               FontSize="11"
                               Foreground="{DynamicResource ForegroundMutedBrush}" />

                    <ListBox ItemsSource="{Binding Sessions}"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type air:AirPlaySession}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             Fill="{DynamicResource SuccessBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundBrush}" />
                                        <TextBlock Text="{Binding ConnectedAt, StringFormat='Connected at {0:HH:mm:ss}'}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RemoteEndpoint}"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundDisabledBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No iPhone or iPad is currently mirroring."
                               Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                               FontStyle="Italic"
                               FontSize="11"
                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
