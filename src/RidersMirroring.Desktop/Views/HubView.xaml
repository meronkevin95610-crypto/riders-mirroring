<UserControl x:Class="Riders.Mirroring.Desktop.Views.HubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Riders.Mirroring.Desktop.ViewModels"
             mc:Ignorable="d"
             Background="{DynamicResource BackgroundCanvasBrush}">
    <UserControl.Resources>

        <!-- ===== Single chrome tab template (x:Shared=False so each tab gets its own instance) ===== -->
        <DataTemplate x:Key="ChromeTabTemplate" DataType="{x:Type vm:MirrorTabViewModel}">
            <Border x:Name="TabBorder"
                    Margin="2,2,2,0"
                    Padding="14,7"
                    CornerRadius="6,6,0,0"
                    BorderThickness="1.5,1.5,1.5,0"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource Gold5Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Live dot indicator (green when streaming) -->
                    <Ellipse Grid.Column="0"
                             Width="8" Height="8"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource ForegroundDisabledBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <RadialGradientBrush Center="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
                                                    <GradientStop Offset="0" Color="#8FDF50" />
                                                    <GradientStop Offset="0.6" Color="{DynamicResource SuccessColor}" />
                                                    <GradientStop Offset="1" Color="{DynamicResource SuccessDarkColor}" />
                                                </RadialGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Tab title -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource ForegroundBrush}" />

                    <!-- Close (×) button -->
                    <Button Grid.Column="2"
                            Margin="10,0,0,0"
                            Padding="4,0"
                            Width="20" Height="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Close tab"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="&#xE711;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Button>
                </Grid>
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Close tab"
                                  Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Border.ContextMenu>
            </Border>

            <!-- Active tab gets a brighter top border + gold title -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Gold2Brush}" />
                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== ItemsPanelTemplate: horizontal chrome strip ===== -->
        <ItemsPanelTemplate x:Key="ChromeTabStripPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Chrome-style tab strip (top)                                  -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundCanvasBrush}"
                BorderBrush="{DynamicResource Gold3Brush}"
                BorderThickness="0,0,0,2"
                Padding="6,4,6,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tabs -->
                <ItemsControl Grid.Column="0"
                              ItemsSource="{Binding Tabs}"
                              ItemTemplate="{StaticResource ChromeTabTemplate}"
                              ItemsPanel="{StaticResource ChromeTabStripPanel}"
                              HorizontalAlignment="Left" />

                <!-- '+' new tab button (placeholder — MainWindow owns the device picker) -->
                <Button Grid.Column="1"
                        Content="+"
                        Width="28" Height="28"
                        Margin="8,2,0,2"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="1.5"
                        BorderBrush="{DynamicResource Gold5Brush}"
                        Foreground="{DynamicResource Gold3Brush}"
                        ToolTip="Open a new mirror tab from the device sidebar"
                        Cursor="Hand" />
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Active tab surface (mirror tiles / single tile)               -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundCanvasBrush}">
            <!-- Empty state when no tabs are open -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasTabs, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                <TextBlock Text="&#xE8AB;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="48"
                           Foreground="{DynamicResource ForegroundMutedBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="No mirroring tab open"
                           FontFamily="{DynamicResource FontDisplay}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4" />
                <TextBlock Text="Select a device from the sidebar and click 'Start mirror'."
                           FontSize="12"
                           Foreground="{DynamicResource ForegroundDisabledBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Selected tab's mirror surface -->
            <ContentControl Content="{Binding SelectedTab}"
                            Visibility="{Binding HasTabs, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:MirrorTabViewModel}">
                        <Grid>
                            <Image Source="{Binding Session.CurrentFrame}"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
