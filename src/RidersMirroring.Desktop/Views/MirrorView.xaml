<UserControl x:Class="Riders.Mirroring.Desktop.Views.MirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Riders.Mirroring.Desktop.ViewModels"
             xmlns:res="clr-namespace:Riders.Mirroring.Desktop.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MirrorViewModel}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource FontFantasy}">

    <UserControl.Resources>
        <!-- Toggle button style for options -->
        <Style x:Key="OptionToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- Remote button style -->
        <Style x:Key="RemoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="920" HorizontalAlignment="Left" Margin="0,0,16,16">

            <!-- ======================================================== -->
            <!-- STATE A: No Device Selected                              -->
            <!-- ======================================================== -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="48,40"
                    Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Border Width="64" Height="64"
                            CornerRadius="32"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20">
                        <TextBlock Text="📱"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{x:Static res:Strings.MirrorEmptyTitle}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="{x:Static res:Strings.MirrorEmptyDescription}"
                               FontSize="12"
                               Margin="0,10,0,24"
                               TextAlignment="Center"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundMutedBrush}" />

                    <Border Background="{DynamicResource SurfaceElevatedBrush}"
                            CornerRadius="8"
                            Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.MirrorEmptyTipHeader}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="{x:Static res:Strings.MirrorEmptyTipBody}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- STATE B: Device Connected and Selected                   -->
            <!-- ======================================================== -->
            <StackPanel Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}">

                <!-- Exit / Error Banner if any -->
                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding ExitBanner, Converter={StaticResource StringToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Static res:Strings.MirrorSessionInfo}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{DynamicResource ErrorBrush}" />
                            <TextBlock Text="{Binding ExitBanner}"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="âœ•"
                                Padding="8,4"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource ForegroundMutedBrush}"
                                Command="{Binding DismissExitBannerCommand}" />
                    </Grid>
                </Border>

                <!-- HERO CARD: Device Info & Big Launch Button -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{DynamicResource CardCornerRadius}"
                        Padding="24"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top row: Device identity + Live Status -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📱" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedDevice.DisplayName}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <Border Margin="12,0,0,0"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedDevice.KindLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="30,4,0,0">
                                    <TextBlock Text="{x:Static res:Strings.MirrorSerialLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDevice.Serial}"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.MirrorStatusLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDevice.StateLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Live Session Badge -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border CornerRadius="8"
                                        Padding="12,6"
                                        Background="{DynamicResource SurfaceElevatedBrush}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource ForegroundDisabledBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{x:Static res:Strings.MirrorRunningBadge}"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding SessionDuration}"
                                                   Margin="6,0,0,0"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource ForegroundBrush}"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{x:Static res:Strings.MirrorReadyBadge}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource ForegroundMutedBrush}"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom row: Launch Button -->
                        <Border Grid.Row="1" Margin="0,20,0,0" Padding="0,16,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundBrush}" />
                                    <TextBlock Text="{x:Static res:Strings.MirrorLatencyBadge}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                </StackPanel>

                                <!-- Mirroring Start / Stop Button -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <!-- START BUTTON (When not running) -->
                                    <Button Command="{Binding StartMirrorCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                            Padding="24,12"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Background="{DynamicResource AccentPrimaryBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="â–¶" Margin="0,0,8,0" FontSize="14" />
                                                        <TextBlock Text="{x:Static res:Strings.MirrorStartButton}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- STOP BUTTON (When running) -->
                                    <Button Command="{Binding StopMirrorCommand}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                            Padding="24,12"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Background="{DynamicResource ErrorBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="â– " Margin="0,0,8,0" FontSize="14" />
                                                        <TextBlock Text="{x:Static res:Strings.MirrorStopButton}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- IN-HUB MIRROR PREVIEW (DWM thumbnail of scrcpy) -->
                    <Border x:Name="MirrorPreviewContainer"
                            Background="#101010"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Height="640"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Text="{x:Static res:Strings.MirrorWaitingForVideo}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- TWO-COLUMN SECTION: OPTIONS & REMOTE CONTROLS -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- COLUMN 1: MIRRORING OPTIONS & PERFORMANCE -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.MirrorSectionStreamingOptions}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{x:Static res:Strings.MirrorSectionStreamingOptionsHint}"
                                       FontSize="11"
                                       Margin="0,2,0,16"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" />

                            <CheckBox Content="{x:Static res:Strings.MirrorOptionKeepAwake}"
                                      IsChecked="{Binding StayAwake}"
                                      Style="{StaticResource OptionToggleStyle}" />

                            <CheckBox Content="{x:Static res:Strings.MirrorOptionTurnScreenOff}"
                                      IsChecked="{Binding TurnScreenOff}"
                                      Style="{StaticResource OptionToggleStyle}" />

                            <CheckBox Content="{x:Static res:Strings.MirrorOptionAlwaysOnTop}"
                                      IsChecked="{Binding AlwaysOnTop}"
                                      Style="{StaticResource OptionToggleStyle}" />

                            <CheckBox Content="{x:Static res:Strings.MirrorOptionFullscreen}"
                                      IsChecked="{Binding Fullscreen}"
                                      Style="{StaticResource OptionToggleStyle}" />

                            <CheckBox Content="{x:Static res:Strings.MirrorOptionAudio}"
                                      IsChecked="{Binding AudioEnabled}"
                                      Style="{StaticResource OptionToggleStyle}" />

                            <CheckBox Content="{x:Static res:Strings.MirrorOptionShowTouches}"
                                      IsChecked="{Binding ShowTouches}"
                                      Style="{StaticResource OptionToggleStyle}" />

                            <Rectangle Height="1" Fill="{DynamicResource DividerBrush}" Margin="0,12" />

                            <!-- Dropdown / Selectors -->
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.MirrorOptionFpsLabel}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableFps}"
                                          SelectedItem="{Binding SelectedFps}"
                                          Width="90"
                                          Height="28" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.MirrorOptionBitrateLabel}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableBitrates}"
                                          SelectedItem="{Binding SelectedBitrate}"
                                          Width="90"
                                          Height="28" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static res:Strings.MirrorOptionResolutionLabel}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ForegroundBrush}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableMaxSizes}"
                                          SelectedItem="{Binding SelectedMaxSize}"
                                          Width="90"
                                          Height="28" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- COLUMN 2: REMOTE CONTROL & SHORTCUTS -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.MirrorSectionRemote}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundBrush}" />
                            <TextBlock Text="{x:Static res:Strings.MirrorSectionRemoteHint}"
                                       FontSize="11"
                                       Margin="0,2,0,16"
                                       Foreground="{DynamicResource ForegroundMutedBrush}" />

                            <!-- Android Navigation Row -->
                            <TextBlock Text="Navigation Android"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       Margin="0,0,0,4" />
                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Button Content="â¬…ï¸ Retour"
                                        Style="{StaticResource RemoteButtonStyle}"
                                        Command="{Binding SendKeyCommand}"
                                        CommandParameter="back" />
                                <Button Content="🏠 Accueil"
                                        Style="{StaticResource RemoteButtonStyle}"
                                        Command="{Binding SendKeyCommand}"
                                        CommandParameter="home" />
                                <Button Content="🕒 Récents"
                                        Style="{StaticResource RemoteButtonStyle}"
                                        Command="{Binding SendKeyCommand}"
                                        CommandParameter="recents" />
                            </UniformGrid>

                            <!-- Physical Controls Row -->
                            <TextBlock Text="Boutons physiques &amp; Système"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundMutedBrush}"
                                       Margin="0,4,0,4" />
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="⚡ Allumer / Veille"
                                        Style="{StaticResource RemoteButtonStyle}"
                                        Command="{Binding SendKeyCommand}"
                                        CommandParameter="power" />
                                <Button Content="🔔 Notifications"
                                        Style="{StaticResource RemoteButtonStyle}"
                                        Command="{Binding ExpandNotificationsCommand}" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Button Content="🔊 Volume +"
                                        Style="{StaticResource RemoteButtonStyle}"
                                        Command="{Binding SendKeyCommand}"
                                        CommandParameter="volumeup" />
                                <Button Content="🔉 Volume -"
                                        Style="{StaticResource RemoteButtonStyle}"
                                        Command="{Binding SendKeyCommand}"
                                        CommandParameter="volumedown" />
                            </UniformGrid>

                            <!-- Screenshot action -->
                            <Button Content="📸 Prendre une capture d'écran"
                                    Style="{StaticResource RemoteButtonStyle}"
                                    Command="{Binding TakeScreenshotCommand}"
                                    Margin="4,4,4,16" />

                            <!-- Keyboard shortcuts cheat sheet -->
                            <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="âŒ¨ï¸ Raccourcis clavier scrcpy :"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    <TextBlock Text="• Alt + F : Basculer en Plein écran&#x0a;• Alt + O : Éteindre l'écran physique&#x0a;• Alt + H : Touche Accueil (Home)&#x0a;• Alt + B : Touche Retour (Back)&#x0a;• Ctrl + V : Coller le texte du PC vers le téléphone"
                                               FontSize="10"
                                               LineHeight="16"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
