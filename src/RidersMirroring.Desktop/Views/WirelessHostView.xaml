<UserControl x:Class="Riders.Mirroring.Desktop.Views.WirelessHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Riders.Mirroring.Desktop.ViewModels"
             xmlns:res="clr-namespace:Riders.Mirroring.Desktop.Resources"
             d:DataContext="{d:DesignInstance Type=vm:WirelessHostViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource FontFantasy}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="{x:Static res:Strings.WirelessHostTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{x:Static res:Strings.WirelessHostDescription}"
                       Margin="0,4,0,24"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ForegroundMutedBrush}" />

            <!-- ===== Wi-Fi credentials ===== -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.WirelessHostWifiNetwork}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}" />
                    <TextBlock Text="{x:Static res:Strings.WirelessHostWifiNetworkHint}"
                               Margin="0,2,0,12"
                               FontSize="11"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               TextWrapping="Wrap" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{x:Static res:Strings.WirelessHostSsidLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Margin="0,4"
                                 Padding="10,6"
                                 Background="{DynamicResource SurfaceElevatedBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 Text="{Binding Ssid, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{x:Static res:Strings.WirelessHostPasswordLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                        <PasswordBox Grid.Row="1" Grid.Column="1"
                                     Margin="0,4"
                                     Padding="10,6"
                                     Background="{DynamicResource SurfaceElevatedBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     x:Name="PasswordBox" />

                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Margin="0,8,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource ForegroundDisabledBrush}"
                                   Text="{x:Static res:Strings.WirelessHostOpenNetworksWarning}" />
                    </Grid>

                    <Button Margin="0,16,0,0"
                            Padding="14,8"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            Command="{Binding GenerateCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.WirelessHostGenerateButton}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== Result card ===== -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource CardCornerRadius}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.WirelessHostStatusLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,2,0,8"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ForegroundBrush}" />

                        <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Device endpoint: "
                                           Foreground="{DynamicResource ForegroundMutedBrush}" />
                                <TextBlock Text="{Binding HostEndpoint}"
                                           FontFamily="Consolas, Cascadia Mono, Segoe UI Mono"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTertiaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="20,0,0,0"
                            Background="White"
                            Padding="12"
                            CornerRadius="12">
                        <Image Source="{Binding QrImage}"
                               Width="220" Height="220"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>