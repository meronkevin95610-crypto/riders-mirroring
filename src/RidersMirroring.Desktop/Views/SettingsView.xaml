<UserControl x:Class="Riders.Mirroring.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Riders.Mirroring.Desktop.ViewModels"
             xmlns:theming="clr-namespace:Riders.Mirroring.Desktop.Theming"
             xmlns:res="clr-namespace:Riders.Mirroring.Desktop.Resources"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Foreground="{DynamicResource ForegroundBrush}"
             FontFamily="{DynamicResource FontFantasy}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Style="{DynamicResource CentreTitleStyle}">
                <Run Text="{x:Static res:Strings.SettingsTitle}" />
                <Run Text=" &#x2014; " FontStyle="Italic" Foreground="{DynamicResource Gold2Brush}" />
                <Run Text="Incantations" FontStyle="Italic" Foreground="{DynamicResource Gold2Brush}" />
            </TextBlock>
            <TextBlock Text="Tune the arcane parameters of the mirror"
                       Style="{DynamicResource CentreSubtitleStyle}"
                       Margin="0,6,0,24" />

            <!-- ===== Appearance card ===== -->
            <Border Style="{DynamicResource QcCardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="6"
                                Background="{DynamicResource Gold2Brush}"
                                BorderBrush="{DynamicResource Gold5Brush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="{DynamicResource BackgroundCanvasBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.SettingsThemeHeader}"
                                   FontFamily="{DynamicResource FontDisplay}"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource Gold1Brush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:Strings.SettingsThemeHint}"
                               FontStyle="Italic" FontSize="12"
                               Foreground="{DynamicResource ForegroundMutedBrush}"
                               Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Button Content="{Binding DarkModeLabel}" Padding="14,6" FontSize="11"
                            Click="OnToggleDarkClick" />
                </StackPanel>
            </Border>

            <!-- ===== Mirror defaults card ===== -->
            <Border Style="{DynamicResource QcCardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="6"
                                Background="{DynamicResource Gold2Brush}"
                                BorderBrush="{DynamicResource Gold5Brush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="{DynamicResource BackgroundCanvasBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Mirror Defaults"
                                   FontFamily="{DynamicResource FontDisplay}"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource Gold1Brush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BITRATE" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="10"
                                   Foreground="{DynamicResource Gold3Brush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Slider Width="280" Minimum="1" Maximum="20" Value="8"
                                    Foreground="{DynamicResource Gold2Brush}" VerticalAlignment="Center" />
                            <TextBlock Text="8 MBPS" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource Gold1Brush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Stay Awake during casting"
                              Foreground="{DynamicResource ForegroundSecondaryBrush}" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Chronicle (logs) card ===== -->
            <Border Style="{DynamicResource QcCardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="6"
                                Background="{DynamicResource Gold2Brush}"
                                BorderBrush="{DynamicResource Gold5Brush}"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="{DynamicResource BackgroundCanvasBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Chronicle (Logs)"
                                   FontFamily="{DynamicResource FontDisplay}"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource Gold1Brush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Debug" Margin="0,0,6,0" Padding="12,5" FontSize="11" />
                        <Button Content="Info" Margin="0,0,6,0" Padding="14,5" FontSize="11"
                                Style="{DynamicResource PrimaryButton}" />
                        <Button Content="Warning" Margin="0,0,6,0" Padding="12,5" FontSize="11" />
                        <Button Content="Error" Padding="14,5" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Reset Scrolls" Margin="0,0,10,0" Padding="18,8" FontSize="12" />
                <Button Content="Inscribe" Style="{DynamicResource PrimaryButton}"
                        Padding="22,8" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>